APP_ENV=development
APP_BASE_URL=http://localhost:5173
APP_TIMEZONE=Asia/Shanghai
VERSION=0.1.4

# PostgreSQL is recommended for deployment. SQLite is convenient for local tests.
DATABASE_URL=postgresql+psycopg://app:password@db:5432/app

SESSION_COOKIE_NAME=session
SESSION_TTL_DAYS=14
SESSION_COOKIE_SECURE=false

BILI_API_BASE_URL=https://mall.bilibili.com
BILI_REQUEST_TIMEOUT_SECONDS=10
BILI_MAX_CONCURRENCY=4
BILI_PRODUCT_LOCK_TIMEOUT_SECONDS=2
BILI_GLOBAL_MIN_INTERVAL_SECONDS=10
BILI_CACHE_REUSE_SECONDS=5
BILI_PRICE_HISTORY_RETENTION_DAYS=90
BILI_REQUEST_EVENT_RETENTION_DAYS=30
MANUAL_REFRESH_COOLDOWN_SECONDS=30

EMAIL_VERIFY_CODE_TTL_MINUTES=10
EMAIL_VERIFY_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFY_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_MINUTES=15
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=3600
FORGOT_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=5

SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USERNAME=
# 163 客户端授权码，不是网页登录密码；仅填写在本机 .env，不要提交到 Git。
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=B站市集好价提示系统
SMTP_USE_SSL=true
SMTP_USE_TLS=false
SMTP_UNCONFIGURED_MAX_ATTEMPTS=3

# The API does not create production tables. Run `alembic upgrade head` first.
